# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit file .env.local ke GitHub.

# Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nomor WhatsApp format internasional tanpa + atau spasi, contoh: 6287857523074
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL domain website saat sudah online (untuk SEO, Sitemap, & Open Graph)
# Contoh: https://sekalarupa.com
NEXT_PUBLIC_SITE_URL=
